---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "@fontsource-variable/source-serif-4";
import sourceSerif4 from "@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url";



interface BasePageProps {
	title?: string;
	description?: string;
	ogtype?: string;
	wide?: boolean;
}

const { title, description, ogtype, wide }: BasePageProps = Astro.props;
---

<!doctype html>
<html lang="en" class="font-serif min-h-full h-100">
	<head>
		<BaseHead title={title} description={description} ogType={ogtype} />
		<link rel="preload" as="font" type="font/woff2" href={sourceSerif4} crossorigin="anonymous"/>
		<slot name="head" />
	</head>
	<body class="">
		<SiteHeader wide={wide} />
		<main>
			<slot />
		</main>
	<Footer />
	</body>
</html>
