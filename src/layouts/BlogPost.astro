---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";
import BasePage from "./BasePage.astro";
import BackLink from "../components/BackLink.astro";
import TableOfContents from "../components/TableOfContents.astro";

type Props = {
  data: CollectionEntry<"blog">["data"];
  headings: { depth: number; slug: string; text: string }[];
  minutes: number;
};
const { data, headings, minutes } = Astro.props;
const { title, description, pubDate, updatedDate, author, useOutline } = data;
const outline = headings.filter((heading) => heading.depth <= 3);
const showOutline = useOutline && outline.length > 0;
---

<BasePage
  title={`${title} | Sam Baumohl`}
  description={description}
  ogtype="article"
  wide
>
  <link
    slot="head"
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/katex@0.13.0/dist/katex.min.css"
  />
  <div class="page-shell article-page">
    <BackLink />
    <header class="article-header">
      <h1>{title}</h1>
      <p class="article-description">{description}</p>
      <div class="article-meta">
        <span>{author}</span><span><FormattedDate date={pubDate} /></span><span
          >{minutes} min read</span
        >{
          updatedDate && (
            <span>
              Updated <FormattedDate date={updatedDate} />
            </span>
          )
        }
      </div>
    </header>
    <div class="article-grid">
      {
        showOutline && (
          <aside class="article-outline">
            <div class="desktop-toc">
              <>
                <p class="eyebrow">On this page</p>
                <TableOfContents headings={outline} />
              </>
            </div>
            <details class="mobile-toc">
              <>
                <summary>
                  On this page <span aria-hidden="true">+</span>
                </summary>
                <TableOfContents headings={outline} />
              </>
            </details>
          </aside>
        )
      }
      <article class="prose article-body" id="article-body"><slot /></article>
    </div>
  </div>
</BasePage>
